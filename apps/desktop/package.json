{
  "name": "@aperadar/desktop",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Modern local-first World of Warships battle intelligence desktop application",
  "author": "ApeRadar Next contributors",
  "license": "MIT",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-electron.mjs",
    "typecheck": "tsc --noEmit",
    "pack": "electron-builder --config electron-builder.json --win --dir",
    "dist:win": "electron-builder --config electron-builder.json --win nsis portable --x64 --publish never",
    "smoke": "node scripts/smoke-desktop.mjs",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@aperadar/server": "workspace:*",
    "@aperadar/shared": "workspace:*",
    "electron-updater": "6.8.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "vite": "8.3.4"
  }
}
