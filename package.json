{
  "name": "aperadar-next",
  "version": "2.0.2",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "description": "Modern local-first World of Warships battle intelligence desktop application",
  "author": "ApeRadar Next contributors",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "postinstall": "pnpm --filter @aperadar/desktop exec install-electron",
    "dev": "pnpm --filter @aperadar/desktop dev",
    "dev:desktop": "pnpm --filter @aperadar/desktop dev",
    "dev:web": "pnpm --filter @aperadar/web dev",
    "build": "node scripts/verify-release-version.mjs && pnpm run typecheck && pnpm run build:web && pnpm run build:desktop",
    "build:web": "pnpm --filter @aperadar/web build",
    "build:desktop": "pnpm --filter @aperadar/desktop build",
    "preview": "pnpm --filter @aperadar/web preview",
    "test": "vitest run --reporter=default --reporter=json --outputFile=artifacts/unit-tests.json",
    "test:api:live": "node --experimental-transform-types scripts/probe-apis.mjs",
    "ships:update": "node --experimental-transform-types scripts/update-ships.mjs",
    "typecheck": "pnpm -r typecheck && tsc --noEmit",
    "check": "pnpm run typecheck && pnpm test && pnpm tokens:check",
    "pack": "pnpm run build && pnpm --filter @aperadar/desktop run pack",
    "dist:win": "pnpm run build && pnpm --filter @aperadar/desktop dist:win",
    "dist": "pnpm run dist:win",
    "smoke:desktop": "pnpm --filter @aperadar/desktop smoke",
    "tokens:check": "node scripts/check-tokens.mjs",
    "verify:package": "pnpm --filter @aperadar/desktop verify:package",
    "verify:updates": "node scripts/verify-update-artifacts.mjs"
  },
  "devDependencies": {
    "@aperadar/shared": "workspace:*",
    "@aperadar/server": "workspace:*",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
